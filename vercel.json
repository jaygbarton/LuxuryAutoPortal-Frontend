{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "goldenluxuryauto.com"
        }
      ],
      "destination": "https://goldenluxuryauto.com/salt-lake-city",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.goldenluxuryauto.com"
        }
      ],
      "destination": "https://goldenluxuryauto.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "app.goldenluxuryauto.com"
        }
      ],
      "destination": "https://gla-v1.vercel.app/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://luxuryautoportal-replit-1.onrender.com/api/:path*"
    },
    {
      "source": "/contracts/:path*",
      "destination": "https://luxuryautoportal-replit-1.onrender.com/contracts/:path*"
    },
    {
      "source": "/signed-contracts/:path*",
      "destination": "https://luxuryautoportal-replit-1.onrender.com/signed-contracts/:path*"
    },
    {
      "source": "/car-photos/:path*",
      "destination": "https://luxuryautoportal-replit-1.onrender.com/car-photos/:path*"
    },
    {
      "source": "/income-expense-images/:path*",
      "destination": "https://luxuryautoportal-replit-1.onrender.com/income-expense-images/:path*"
    },
    {
      "source": "/((?!api/|contracts/|signed-contracts/|car-photos/|income-expense-images/).*)",
      "destination": "/index.html"
    }
  ]
}
