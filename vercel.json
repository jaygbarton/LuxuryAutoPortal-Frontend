{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/sign-contract/:path*",
      "has": [
        {
          "type": "host",
          "value": "app.goldenluxuryauto.com"
        }
      ],
      "destination": "https://goldenluxuryauto.com/sign-contract/:path*",
      "permanent": true
    },
    {
      "source": "/maintenance-approval/:path*",
      "has": [
        {
          "type": "host",
          "value": "app.goldenluxuryauto.com"
        }
      ],
      "destination": "https://goldenluxuryauto.com/maintenance-approval/:path*",
      "permanent": true
    },
    {
      "source": "/reset-password",
      "has": [
        {
          "type": "host",
          "value": "app.goldenluxuryauto.com"
        }
      ],
      "destination": "https://goldenluxuryauto.com/reset-password",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.goldenluxuryauto.com"
        }
      ],
      "destination": "https://app.goldenluxuryauto.com/login",
      "permanent": false
    },
    {
      "source": "/salt-lake-city",
      "has": [
        {
          "type": "host",
          "value": "app.goldenluxuryauto.com"
        }
      ],
      "destination": "https://goldenluxuryauto.com/salt-lake-city",
      "permanent": true
    },
    {
      "source": "/:path(fleet|pick-up-and-drop-off|detail-shop|chauffeur-services|deals|jobs|privacy-policy|terms-and-conditions|terms|testimonials|reviews-options|reviews|extras|suggested-cars|onboarding|contact)",
      "has": [
        {
          "type": "host",
          "value": "app.goldenluxuryauto.com"
        }
      ],
      "destination": "https://goldenluxuryauto.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(fleet|pick-up-and-drop-off|detail-shop|chauffeur-services|deals|jobs|privacy-policy|terms-and-conditions|terms|testimonials|reviews-options|reviews|extras|suggested-cars|onboarding|contact)/:rest*",
      "has": [
        {
          "type": "host",
          "value": "app.goldenluxuryauto.com"
        }
      ],
      "destination": "https://goldenluxuryauto.com/:path/:rest*",
      "permanent": true
    },
    {
      "source": "/:location(salt-lake-city|wilmington-nc|myrtle-beach-sc|charleston-sc)/:path*",
      "has": [
        {
          "type": "host",
          "value": "app.goldenluxuryauto.com"
        }
      ],
      "destination": "https://goldenluxuryauto.com/:location/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "goldenluxuryauto.com"
        }
      ],
      "destination": "https://goldenluxuryauto.com/salt-lake-city",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.goldenluxuryauto.com"
        }
      ],
      "destination": "https://goldenluxuryauto.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/img/:path*",
      "has": [
        {
          "type": "host",
          "value": "app.goldenluxuryauto.com"
        }
      ],
      "destination": "/legacy-img/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://luxuryautoportal-replit-1.onrender.com/api/:path*"
    },
    {
      "source": "/rest/:path*",
      "destination": "https://luxuryautoportal-replit-1.onrender.com/rest/:path*"
    },
    {
      "source": "/contracts/:path*",
      "destination": "https://luxuryautoportal-replit-1.onrender.com/contracts/:path*"
    },
    {
      "source": "/signed-contracts/:path*",
      "destination": "https://luxuryautoportal-replit-1.onrender.com/signed-contracts/:path*"
    },
    {
      "source": "/car-photos/:path*",
      "destination": "https://luxuryautoportal-replit-1.onrender.com/car-photos/:path*"
    },
    {
      "source": "/income-expense-images/:path*",
      "destination": "https://luxuryautoportal-replit-1.onrender.com/income-expense-images/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "app.goldenluxuryauto.com"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|rest/|contracts/|signed-contracts/|car-photos/|income-expense-images/).*)",
      "destination": "/index.html"
    }
  ]
}
