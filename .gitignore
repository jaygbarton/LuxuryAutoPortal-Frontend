# Environment variables
.env
.env.local
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local
# Any other env variant, but keep the committed template.
.env.*
!.env.example
!**/.env.example

# Build outputs
frontend/dist
dist/
backend/dist

# TypeScript incremental build cache (auto-generated, should never be committed)
*.tsbuildinfo

# Node modules
node_modules/
frontend/node_modules/
backend/node_modules/

# Logs
*.log
npm-debug.log*

# Editor/IDE files
.vscode/

# Vercel
.vercel

# Playwright test output (screenshots, traces, reports from local runs)
test-results/
playwright-report/
coverage/
.nyc_output/

# Database dumps — this repo should never contain one. The backend repo had
# 69 files of real production rows committed; keep the same guard here.
# No negation needed: this repo has no legitimate .sql files.
*.sql
*.dump
*.sql.gz
*.mysqldump
migration-backups/
db-backups/
backups/

# Editor / tooling leftovers. src/pages/admin/payments.tsx.backup was tracked
# for months, unreferenced and diverged from the live file.
*.backup
*.bak
*.orig
*.rej
*~

# jscpd duplication reports (generated by npx jscpd / CI)
reports/
